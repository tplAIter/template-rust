{{- /*
  Fragment: alloy (profile: obs — Grafana Alloy scrapes docker container logs → loki)
  Requires .Project.Slug (container name only). Config mounted from
  .infra/observability/alloy/config.alloy. Needs the docker socket to discover
  container logs.
  Assembled by: {{ template "compose.alloy" . }}
*/ -}}
{{- define "compose.alloy" }}
  alloy:
    image: grafana/alloy:v1.5.1
    container_name: {{ .Project.Slug }}_alloy
    profiles:
      - obs
    depends_on:
      - loki
    ports:
      - "${GOTMPL_ALLOY_PORT:-12345}:12345"
    command:
      - run
      - --server.http.listen-addr=0.0.0.0:12345
      - --storage.path=/var/lib/alloy/data
      - /etc/alloy/config.alloy
    volumes:
      - ./.infra/observability/alloy/config.alloy:/etc/alloy/config.alloy:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./.local/docker/alloy:/var/lib/alloy/data
{{- end }}
