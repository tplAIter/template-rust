    repository::{{ .Name.Snake }}_repository::{{ .Name.Pascal }}Repository,
    service::{{ .Name.Snake }}::{{ .Name.Pascal }}Service,
};
use axum::{
    Json, Router,
    extract::{Path, State},
    http::StatusCode,
    response::{IntoResponse, Response},
    routing::get,
};

type Service = {{ .Name.Pascal }}Service<{{ .Name.Pascal }}UseCase<{{ .Name.Pascal }}Repository>>;
fn service(state: &HealthState) -> Result<Service, Box<Response>> {
    state
        .database
        .clone()
        .map(|pool| {{ .Name.Pascal }}Service::new({{ .Name.Pascal }}UseCase::new({{ .Name.Pascal }}Repository::new(pool))))
        .ok_or_else(|| {
            Box::new((StatusCode::SERVICE_UNAVAILABLE, "database unavailable").into_response())
        })
}
fn error(value: DomainError) -> Response {
    let status = match value {
        DomainError::Validation(_) => StatusCode::BAD_REQUEST,
        DomainError::NotFound => StatusCode::NOT_FOUND,
        DomainError::Storage => StatusCode::INTERNAL_SERVER_ERROR,
    };
    (
        status,
        Json(serde_json::json!({"code": match status {StatusCode::BAD_REQUEST => "validation_error", StatusCode::NOT_FOUND => "not_found", _ => "storage_error"}})),
    )
        .into_response()
}
pub fn router() -> Router<HealthState> {
    Router::new()
        .route("/{{ .Name.Kebab }}", axum::routing::post(create))
        .route("/{{ .Name.Kebab }}/{id}", get(find).put(update).delete(delete))
}
pub async fn create(State(state): State<HealthState>, Json(value): Json<{{ .Name.Pascal }}>) -> Response {
    let service = match service(&state) {
        Ok(v) => v,
        Err(e) => return *e,
    };
    match service.create(&value).await {
        Ok(()) => (StatusCode::CREATED, Json(value)).into_response(),
        Err(e) => error(e),
    }
}
pub async fn find(State(state): State<HealthState>, Path(id): Path<String>) -> Response {
    let service = match service(&state) {
        Ok(v) => v,
        Err(e) => return *e,
    };
    match service.find(&id).await {
        Ok(v) => Json(v).into_response(),
        Err(e) => error(e),
    }
}
pub async fn update(
    State(state): State<HealthState>,
    Path(id): Path<String>,
    Json(mut value): Json<{{ .Name.Pascal }}>,
) -> Response {
    if value.id != id {
        return error(DomainError::Validation("body and path id differ".into()));
    }
    value.id = id;
    let service = match service(&state) {
        Ok(v) => v,
        Err(e) => return *e,
    };
    match service.update(&value).await {
        Ok(()) => StatusCode::NO_CONTENT.into_response(),
        Err(e) => error(e),
    }
}
pub async fn delete(State(state): State<HealthState>, Path(id): Path<String>) -> Response {
    let service = match service(&state) {
        Ok(v) => v,
        Err(e) => return *e,
    };
    match service.delete(&id).await {
        Ok(()) => StatusCode::NO_CONTENT.into_response(),
        Err(e) => error(e),
    }
}
#[cfg(test)]
mod tests {
    use super::*;
    use axum::{body::Body, http::Request};
    use tower::ServiceExt;
    #[tokio::test]
    async fn actual_router_refuses_missing_database_without_connecting() {
        let response = router()
            .with_state(HealthState::without_database())
            .oneshot(
                Request::builder()
                    .uri("/{{ .Name.Kebab }}/00000000-0000-0000-0000-000000000001")
                    .body(Body::empty())
                    .unwrap(),
            )
            .await
            .unwrap();
        assert_eq!(response.status(), StatusCode::SERVICE_UNAVAILABLE);
    }
    #[test]
    fn domain_errors_have_explicit_http_status() {
        assert_eq!(error(DomainError::NotFound).status(), StatusCode::NOT_FOUND);
        assert_eq!(
            error(DomainError::Storage).status(),
            StatusCode::INTERNAL_SERVER_ERROR
        );
        assert_eq!(
            error(DomainError::Validation("invalid".into())).status(),
            StatusCode::BAD_REQUEST
        );
    }
}
