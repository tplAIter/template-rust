use axum::{Json, extract::State, http::StatusCode, response::IntoResponse};
use serde::Serialize;
{{- if is "database" "postgres" }}
use sqlx::PgPool;
{{- end }}

#[derive(Clone)]
{{ if is "database" "postgres" -}}
pub struct HealthState {
    pub database: Option<PgPool>,
}
{{- else -}}
pub struct HealthState {}
{{- end }}

impl HealthState {
{{- if is "database" "postgres" }}
    pub fn with_database(database: PgPool) -> Self {
        Self {
            database: Some(database),
        }
    }
{{- end }}
    // The PostgreSQL application uses `with_database` at runtime; the
    // database-free constructor is retained only for router unit tests in
    // that profile. In the `database=none` profile it remains runtime API.
{{- if is "database" "postgres" }}
    #[cfg(test)]
{{- end }}
    pub fn without_database() -> Self {
{{- if is "database" "postgres" }}
        Self { database: None }
{{- else }}
        Self {}
{{- end }}
    }
}

#[derive(Serialize)]
struct Health {
    status: &'static str,
}

pub async fn liveness() -> impl IntoResponse {
    (StatusCode::OK, Json(Health { status: "ok" }))
}

pub async fn readiness(State(state): State<HealthState>) -> impl IntoResponse {
{{- if is "database" "postgres" }}
    if let Some(database) = &state.database {
        if bounded_database_operation(sqlx::query("SELECT 1").execute(database))
            .await
            .is_err()
        {
            return (
                StatusCode::SERVICE_UNAVAILABLE,
                Json(Health {
                    status: "unavailable",
                }),
            );
        }
    }
{{- else }}
    let _ = state;
{{- end }}
    (StatusCode::OK, Json(Health { status: "ready" }))
}
{{- if is "database" "postgres" }}

#[cfg(test)]
mod tests {
    use super::bounded_database_operation;

    #[tokio::test]
    async fn database_probe_accepts_success_and_refuses_error_or_timeout() {
        assert_eq!(
            bounded_database_operation(async { Ok::<_, ()>(()) }).await,
            Ok(())
        );
        assert!(
            bounded_database_operation(async { Err::<(), _>(()) })
                .await
                .is_err()
        );
        assert!(
            bounded_database_operation(async {
                tokio::time::sleep(std::time::Duration::from_secs(6)).await;
                Ok::<_, ()>(())
            })
            .await
            .is_err()
        );
    }
}
{{- end }}
