#[cfg(test)]
mod tests {
    use super::*;
    use std::sync::Mutex;
    struct Memory(Mutex<Option<{{ .Name.Pascal }}>>);
    impl {{ .Name.Pascal }}RepositoryPort for Memory {
        fn create<'a>(&'a self, v: &'a {{ .Name.Pascal }}) -> RepositoryFuture<'a, ()> {
            Box::pin(async move {
                *self.0.lock().unwrap() = Some(v.clone());
                Ok(())
            })
        }
        fn find<'a>(&'a self, id: &'a str) -> RepositoryFuture<'a, Option<{{ .Name.Pascal }}>> {
            Box::pin(async move {
                Ok(self
                    .0
                    .lock()
                    .unwrap()
                    .as_ref()
                    .filter(|v| v.id == id)
                    .cloned())
            })
        }
        fn update<'a>(&'a self, v: &'a {{ .Name.Pascal }}) -> RepositoryFuture<'a, bool> {
            Box::pin(async move {
                let mut row = self.0.lock().unwrap();
                if row.as_ref().is_some_and(|x| x.id == v.id) {
                    *row = Some(v.clone());
                    Ok(true)
                } else {
                    Ok(false)
                }
            })
        }
        fn delete<'a>(&'a self, id: &'a str) -> RepositoryFuture<'a, bool> {
            Box::pin(async move {
                let mut row = self.0.lock().unwrap();
                if row.as_ref().is_some_and(|x| x.id == id) {
                    *row = None;
                    Ok(true)
