# Runtime process configuration. `make run` loads this file when it exists.
APP_NAME={{ .Project.Slug }}
APP_LISTEN_ADDR=0.0.0.0:{{ .Runtime.Port }}

# Host-side Docker port mappings. Change either value to run several generated
# projects at once; container ports and inter-container addresses stay stable.
APP_HOST_PORT={{ .Runtime.Port }}
POSTGRES_HOST_PORT={{ .Settings.postgres_host_port }}

# The local process reaches the published PostgreSQL host port. The Compose app
# container receives its own DATABASE_URL with hostname `postgres`.
DATABASE_URL=postgres://postgres:postgres@localhost:${POSTGRES_HOST_PORT}/{{ .Project.Slug }}
