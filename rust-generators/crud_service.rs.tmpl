    #[tokio::test]
    async fn complete_bridge_round_trip_and_missing_rows() {
        let service =
            {{ .Name.Pascal }}Service::new({{ .Name.Pascal }}UseCase::new(Memory(Mutex::new(None))));
        let mut value = {{ .Name.Pascal }} {
            id: "00000000-0000-0000-0000-000000000001".into(),
