use sqlx::{PgPool, Row};

use crate::domain::DomainError;

#[derive(Debug)]
pub struct {{ .Name.Pascal }}Row {
    pub id: String,
    pub name: String,
}

/// SQLx adapter kept behind the repository boundary.
pub struct {{ .Name.Pascal }}Repository {
    pool: PgPool,
}

impl {{ .Name.Pascal }}Repository {
    pub fn new(pool: PgPool) -> Self { Self { pool } }

    pub async fn find(&self, id: &str) -> Result<Option<{{ .Name.Pascal }}Row>, DomainError> {
        let row = sqlx::query("SELECT id::text, name FROM {{ .Params.table }} WHERE id = $1::uuid")
        .bind(id)
        .fetch_optional(&self.pool)
        .await
        .map_err(|_| DomainError::Storage)?;
        row.map(|row| {
            Ok({{ .Name.Pascal }}Row {
                id: row.try_get("id").map_err(|_| DomainError::Storage)?,
                name: row.try_get("name").map_err(|_| DomainError::Storage)?,
            })
        }).transpose()
    }

    pub async fn delete(&self, id: &str) -> Result<bool, DomainError> {
        let result = sqlx::query("DELETE FROM {{ .Params.table }} WHERE id = $1::uuid")
            .bind(id)
            .execute(&self.pool)
            .await
            .map_err(|_| DomainError::Storage)?;
        Ok(result.rows_affected() == 1)
    }
}

#[cfg(test)]
mod postgres_tests {
    use super::*;

    #[tokio::test]
    async fn repository_find_and_delete_round_trip() {
        let Ok(database_url) = std::env::var("DATABASE_URL") else { return };
        let pool = sqlx::postgres::PgPoolOptions::new()
            .max_connections(1)
            .connect(&database_url)
            .await
            .expect("DATABASE_URL must point to the test database");
        sqlx::query("CREATE TEMP TABLE {{ .Params.table }} (id UUID PRIMARY KEY, name TEXT NOT NULL)")
            .execute(&pool).await.expect("create test table");
        let id = "00000000-0000-0000-0000-000000000001";
        sqlx::query("INSERT INTO {{ .Params.table }} (id, name) VALUES ($1::uuid, $2)")
            .bind(id).bind("test").execute(&pool).await.expect("insert test row");
        let repository = {{ .Name.Pascal }}Repository::new(pool);
        assert!(repository.find(id).await.expect("find").is_some());
        assert!(repository.delete(id).await.expect("delete"));
        assert!(repository.find(id).await.expect("find after delete").is_none());
    }
}
