        assert_eq!(service.delete(&value.id).await, Err(DomainError::NotFound));
        service.create(&value).await.unwrap();
        assert_eq!(service.find(&value.id).await.unwrap(), value);
        value.name = "second".into();
        service.update(&value).await.unwrap();
        assert_eq!(service.find(&value.id).await.unwrap(), value);
        service.delete(&value.id).await.unwrap();
        assert_eq!(service.find(&value.id).await, Err(DomainError::NotFound));
        assert!(matches!(
