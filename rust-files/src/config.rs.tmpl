use anyhow::{bail, Result};

#[derive(Clone, Debug)]
pub struct Config {
    pub service_name: String,
    pub listen_addr: String,
{{- if is "database" "postgres" }}
    pub database_url: String,
{{- end }}
}

impl Config {
    pub fn from_env() -> Result<Self> {
        let service_name =
            std::env::var("APP_NAME").unwrap_or_else(|_| "{{ .Project.Slug }}".into());
        let listen_addr = std::env::var("APP_LISTEN_ADDR")
            .unwrap_or_else(|_| "0.0.0.0:{{ .Runtime.Port }}".into());
{{- if is "database" "postgres" }}
        let database_url = std::env::var("DATABASE_URL")
            .unwrap_or_else(|_| "postgres://postgres:postgres@localhost:5432/{{ .Project.Slug }}".into());
{{- end }}
        if service_name.trim().is_empty() {
            bail!("APP_NAME must not be empty");
        }
        Ok(Self {
            service_name,
            listen_addr,
{{- if is "database" "postgres" }}
            database_url,
{{- end }}
        })
    }
}

#[cfg(test)]
mod tests {
    use super::Config;

    #[test]
    fn default_configuration_is_valid() {
        let config = Config::from_env().expect("config");
        assert!(!config.listen_addr.is_empty());
    }
}
