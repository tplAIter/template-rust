{{- /*
  Fragment: loki (profile: obs — log store for the default obs pipeline)
  Requires .Project.Slug (container name only). Config mounted from
  .infra/observability/loki/loki-config.yml.
  Assembled by: {{ template "compose.loki" . }}
*/ -}}
{{- define "compose.loki" }}
  loki:
    image: grafana/loki:3.3.2
    container_name: {{ .Project.Slug }}_loki
    profiles:
      - obs
    ports:
      - "${GOTMPL_LOKI_PORT:-3100}:3100"
    command: -config.file=/etc/loki/loki-config.yml
    volumes:
      - ./.infra/observability/loki/loki-config.yml:/etc/loki/loki-config.yml:ro
      - ./.local/docker/loki:/loki
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O- http://localhost:3100/ready | grep -q ready || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 20s
{{- end }}
